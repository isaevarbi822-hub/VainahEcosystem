# Local default: SQLite stored in ./data/vainah.db
# DATABASE_URL=sqlite:////absolute/path/to/vainah.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
# DATABASE_URL=
ENVIRONMENT=development
COOKIE_SECURE=false
APP_ORIGIN=http://127.0.0.1:8000

# Private media (optional; defaults to ./data/uploads)
# VAINAH_UPLOAD_DIR=/absolute/path/to/uploads

# Optional AI endpoint. Never commit real keys.
# VAINAH_AI_BASE_URL=https://your-compatible-ai-api.example/v1
# VAINAH_AI_API_KEY=
# VAINAH_AI_MODEL=

# Render/private beta preview:
# ENVIRONMENT=production
# COOKIE_SECURE=true
# APP_ORIGIN=https://your-service.onrender.com
# DATABASE_URL=postgresql://USER:...@NEON-POOLER/HERE?sslmode=require
# VAINAH_SIGNUP_CODE=use-your-own-long-random-invite-code
# VAINAH_MEDIA_BACKEND=database
# VAINAH_RATE_LIMIT=true

# Optional Google Identity Services for the browser version of Vainah.
# Public Web OAuth Client ID, NOT a client secret.
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized JavaScript origins: your exact HTTPS Render address.
# GOOGLE_CLIENT_ID=000000000000-xxxx.apps.googleusercontent.com

# Standalone Vainah Messenger: allow immediate email registration.
# Keep private invite-only mode if you cannot yet moderate public registrations.
VAINAH_SIGNUP_MODE=open

# Comma-separated IDs of staff accounts authorized to issue verified badges.
# Copy UUID from Vainah Messenger → Profile → Your Vainah ID.
VAINAH_VERIFICATION_ADMIN_IDS=
